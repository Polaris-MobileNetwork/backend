## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Bb]in/
[Oo]bj/
**/bin/
**/obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio Code
.vscode/
.VS/

# Rider
.idea/

# ASP.NET Core
wwwroot/
appsettings.Development.json
appsettings.*.json

# Log files
*.log

# DotNet CLI artifacts
project.lock.json
project.fragment.lock.json
artifacts/

# VS for Mac
*.pidb
*.userprefs




# Others
*.ncrunch*
*.localhistory
*.sql
*.sqlite
*.db

# Test results
TestResults/
*.trx

# Azure
.publish/

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NCrunch
*.ncrunch*
.*crunch*.local.xml

# Coverage
coverage/
*.coverage
*.coveragexml
*.codecoverage

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
*.nuspec

# Logs
logs/
*.log

# Cache
.cache/

# Temporary
*.tmp
*.bak

# Rider IDE
.idea/

# Rider local solution settings
*.sln.iml

# DotNet Tool Manifest
.dotnet-tools.json

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Ignore secrets
secrets.json
